/* 单列与双列统一使用组件内卡片变量，避免依赖全局样式穿透 */
.card-double,
.card-single {
  background: var(--color-card);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
}

/* 双列卡片 */
.card-double {
  overflow: hidden;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.card-double:active {
  transform: scale(0.985);
  box-shadow: 0 4rpx 20rpx var(--color-primary-soft);
}

.cover-wrap {
  width: 100%;
  height: 320rpx;
  background: var(--color-fill);
}

.cover {
  width: 100%;
  height: 100%;
  display: block;
}

.cover-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--color-text-3);
}

.cover-placeholder-icon {
  font-size: 52rpx;
  margin-bottom: 8rpx;
}

.cover-placeholder-text {
  font-size: 26rpx;
}

.double-body {
  padding: 16rpx 20rpx 20rpx;
}

.title {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--color-text);
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.amount-row {
  margin-top: 10rpx;
  display: flex;
  flex-direction: row;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 12rpx;
}

.amount {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-primary);
}

.holding {
  font-size: 24rpx;
  color: var(--color-text-2);
}

/* 单列卡片 */
.card-single {
  display: flex;
  flex-direction: row;
  padding: 20rpx;
  margin-bottom: 20rpx;
  transition: transform 0.15s ease;
}

.card-single:active {
  transform: scale(0.99);
}

.single-cover-wrap {
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: var(--color-fill);
  flex-shrink: 0;
}

.single-cover {
  width: 100%;
  height: 100%;
  display: block;
}

.single-cover-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-3);
  font-size: 48rpx;
}

.single-body {
  flex: 1;
  min-width: 0;
  margin-left: 22rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.single-body .amount {
  font-size: 36rpx;
}

.meta {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
}

.meta-date {
  font-size: 26rpx;
  color: var(--color-text-2);
}

.meta-tag {
  font-size: 24rpx;
  color: var(--color-primary);
  background: var(--color-primary-soft);
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  line-height: 1.4;
}

/* 双列卡片 */
.card-double {
  background: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(24, 24, 24, 0.05);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.card-double:active {
  transform: scale(0.985);
  box-shadow: 0 4rpx 20rpx rgba(0, 82, 217, 0.10);
}

.cover-wrap {
  width: 100%;
  height: 320rpx;
  background: #EEF1F4;
}

.cover {
  width: 100%;
  height: 100%;
  display: block;
}

.cover-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #A6ABB3;
}

.cover-placeholder-icon {
  font-size: 52rpx;
  margin-bottom: 8rpx;
}

.cover-placeholder-text {
  font-size: 26rpx;
}

.double-body {
  padding: 16rpx 20rpx 20rpx;
}

.title {
  font-size: 32rpx;
  font-weight: 500;
  color: #181818;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.amount {
  margin-top: 10rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #0052D9;
}

/* 单列卡片 */
.card-single {
  display: flex;
  flex-direction: row;
  padding: 20rpx;
  margin-bottom: 20rpx;
  transition: transform 0.15s ease;
}

.card-single:active {
  transform: scale(0.99);
}

.single-cover-wrap {
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #EEF1F4;
  flex-shrink: 0;
}

.single-cover {
  width: 100%;
  height: 100%;
  display: block;
}

.single-cover-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #A6ABB3;
  font-size: 48rpx;
}

.single-body {
  flex: 1;
  min-width: 0;
  margin-left: 22rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.single-body .amount {
  font-size: 36rpx;
}

.meta {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
}

.meta-date {
  font-size: 26rpx;
  color: #666666;
}

.meta-tag {
  font-size: 24rpx;
  color: #266FE8;
  background: rgba(38, 111, 232, 0.08);
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  line-height: 1.4;
}

.picker-empty {
  font-size: 26rpx;
  color: #A6ABB3;
}

.picker-tags {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 16rpx;
}

.picker-tag {
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  background: #F5F6F8;
  color: #333333;
  font-size: 28rpx;
  transition: all 0.15s ease;
}

.picker-tag--active {
  background: rgba(0, 82, 217, 0.10);
  color: #0052D9;
  border: 1rpx solid rgba(0, 82, 217, 0.4);
  font-weight: 500;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 76rpx;
  line-height: 1;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 32rpx;
  color: #666666;
}

.empty-hint {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #A6ABB3;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 128rpx;
  height: 128rpx;
  margin-bottom: 24rpx;
  border-radius: 50%;
  background: var(--color-fill);
  font-size: 64rpx;
  line-height: 1;
  opacity: 0.75;
}

.empty-text {
  font-size: 32rpx;
  color: var(--color-text-2);
}

.empty-hint {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--color-text-3);
}

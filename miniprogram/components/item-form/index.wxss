.form {
  display: flex;
  flex-direction: column;
}

.section-title {
  margin: 28rpx 4rpx 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}

.required {
  color: var(--color-danger);
}

.optional {
  margin-left: 8rpx;
  font-size: 24rpx;
  font-weight: 400;
  color: var(--color-text-3);
}

.section {
  padding: 8rpx 24rpx 24rpx;
}

.detail-empty {
  padding: 16rpx 0;
  font-size: 26rpx;
  color: var(--color-text-3);
}

.detail-row {
  padding: 20rpx 0 8rpx;
  border-bottom: 1rpx solid var(--color-border);
  margin-bottom: 12rpx;
}

.mode-row {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 0 16rpx;
}

.mode-row--compact {
  padding: 0 0 12rpx;
}

.mode-chip {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: var(--color-bg);
  color: var(--color-text);
  font-size: 24rpx;
  transition: all 0.15s ease;
}

.mode-chip--sm {
  padding: 6rpx 16rpx;
  font-size: 22rpx;
}

.mode-chip--active {
  background: var(--color-primary-soft);
  color: var(--color-primary);
  border: 1rpx solid var(--color-primary-border);
  font-weight: 500;
}

.mode-warning {
  padding: 8rpx 0 16rpx;
  font-size: 24rpx;
  color: var(--color-warning);
}

.url-preview {
  margin-top: 12rpx;
  padding: 14rpx 18rpx;
  background: var(--color-bg);
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  word-break: break-all;
}

.url-preview--row {
  margin-top: 12rpx;
  margin-bottom: 8rpx;
}

.url-preview-label {
  font-size: 22rpx;
  color: var(--color-text-3);
  line-height: 1.4;
}

.url-preview-value {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--color-primary);
  line-height: 1.5;
  word-break: break-all;
}

.row-actions {
  margin-left: auto;
  display: flex;
  flex-direction: row;
  gap: 20rpx;
}

.row-action {
  font-size: 24rpx;
  color: var(--color-primary);
}

.row-action--danger {
  color: var(--color-danger);
}

.field-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.field-label {
  font-size: 28rpx;
  color: var(--color-text);
}

.field-value {
  font-size: 28rpx;
  color: var(--color-text-2);
}

.submit-wrap {
  margin-top: 40rpx;
  padding: 0 8rpx 40rpx;
}

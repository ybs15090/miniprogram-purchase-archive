:host {
  display: block;
  margin-top: 20rpx;
}

.skeleton-cards {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
}

.skeleton-card,
.skeleton-row {
  overflow: hidden;
  background: var(--color-card, #FFFFFF);
  border-radius: var(--radius-card, 20rpx);
  box-shadow: var(--shadow-card, 0 2rpx 12rpx rgba(24, 24, 24, 0.04));
}

.skeleton-card-cover {
  height: 320rpx;
}

.skeleton-card-body {
  padding: 20rpx;
}

.skeleton-row {
  display: flex;
  align-items: center;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.skeleton-thumb {
  width: 144rpx;
  height: 144rpx;
  flex-shrink: 0;
  border-radius: 12rpx;
}

.skeleton-row-body {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.skeleton-block {
  background: var(--color-fill, #EEF1F4);
  animation: sk-pulse 1.2s ease-in-out infinite;
}

.skeleton-line {
  width: 100%;
  height: 28rpx;
  border-radius: 8rpx;
}

.skeleton-line--short {
  width: 58%;
  margin-top: 18rpx;
}

@keyframes sk-pulse {
  0%,
  100% {
    opacity: 1;
  }

  50% {
    opacity: 0.45;
  }
}

<view wx:if="{{type === 'cards'}}" class="skeleton-cards">
  <view wx:for="{{items}}" wx:key="index" class="skeleton-card">
    <view class="skeleton-block skeleton-card-cover"></view>
    <view class="skeleton-card-body">
      <view class="skeleton-block skeleton-line"></view>
      <view class="skeleton-block skeleton-line skeleton-line--short"></view>
    </view>
  </view>
</view>

<view wx:else class="skeleton-list">
  <view wx:for="{{items}}" wx:key="index" class="skeleton-row">
    <view class="skeleton-block skeleton-thumb"></view>
    <view class="skeleton-row-body">
      <view class="skeleton-block skeleton-line"></view>
      <view class="skeleton-block skeleton-line skeleton-line--short"></view>
    </view>
  </view>
</view>

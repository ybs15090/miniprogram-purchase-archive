.manage-page {
  display: flex;
  flex-direction: column;
}

.row-list {
  padding: 0 28rpx;
}

.row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.row:last-child {
  border-bottom: none;
}

.row-main {
  min-width: 0;
}

.row-name {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--color-text);
}

.row-count {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--color-text-3);
}

.row-ops {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 24rpx;
  flex-shrink: 0;
}

.op {
  font-size: 26rpx;
  color: var(--color-primary);
}

.op--move {
  color: var(--color-text-2);
}

.op--danger {
  color: var(--color-danger);
}

.add-btn {
  margin-top: 32rpx;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 16rpx;
  background: var(--color-card);
  color: var(--color-primary);
  font-size: 30rpx;
  font-weight: 500;
  box-shadow: 0 2rpx 12rpx var(--shadow-card);
  transition: transform 0.15s ease;
}

.add-btn:active {
  transform: scale(0.98);
}

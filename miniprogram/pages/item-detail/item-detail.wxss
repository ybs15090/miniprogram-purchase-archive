.detail-page {
  display: flex;
  flex-direction: column;
}

.cover-card {
  overflow: hidden;
}

.cover {
  width: 100%;
  aspect-ratio: 4 / 3;
  height: auto;
  display: block;
  background: var(--color-fill);
}

.cover--placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--color-text-3);
  font-size: 64rpx;
}

.cover--placeholder-text {
  margin-top: 12rpx;
  font-size: 26rpx;
}

.base-card {
  margin-top: 20rpx;
  padding: 28rpx;
}

.detail-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text);
  line-height: 1.4;
}

.detail-amount-row {
  margin-top: 14rpx;
  display: flex;
  flex-direction: row;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 16rpx;
}

.detail-amount {
  font-size: 26rpx;
  font-weight: 400;
  color: var(--color-text-2);
}

.detail-holding {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.amount-meta {
  margin-top: 10rpx;
  display: flex;
  flex-direction: row;
  gap: 24rpx;
  font-size: 26rpx;
  color: var(--color-text-2);
}

.category-tags {
  margin-top: 18rpx;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 12rpx;
}

.category-tag {
  font-size: 24rpx;
  color: var(--color-primary);
  background: var(--color-primary-soft);
  border-radius: 8rpx;
  padding: 6rpx 16rpx;
}

.section-title {
  margin: 32rpx 4rpx 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}

.field-card {
  padding: 8rpx 28rpx;
}

.field-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.field-row:last-child {
  border-bottom: none;
}

.field-row--link {
  justify-content: space-between;
}

.field-label {
  font-size: 28rpx;
  color: var(--color-text-2);
}

.field-value {
  font-size: 28rpx;
  color: var(--color-text);
  text-align: right;
  max-width: 60%;
  word-break: break-all;
}

.order-number {
  font-size: 26rpx;
}

.field-link {
  font-size: 28rpx;
  color: var(--color-primary);
}

.desc-card {
  padding: 28rpx;
}

.desc-text {
  font-size: 28rpx;
  color: var(--color-text);
  line-height: 1.7;
  word-break: break-all;
}

.desc-text--muted {
  color: var(--color-text-3);
}

.detail-images {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.detail-image {
  width: 100%;
  height: 420rpx;
  border-radius: 20rpx;
  background: var(--color-fill);
}

.detail-image--placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-3);
  font-size: 26rpx;
}

.actions {
  margin-top: 40rpx;
  display: flex;
  flex-direction: row;
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 16rpx;
  background: var(--color-card);
  color: var(--color-text);
  font-size: 30rpx;
  box-shadow: 0 2rpx 12rpx var(--shadow-card);
  transition: transform 0.15s ease;
}

.action-btn:active {
  transform: scale(0.97);
}

.action-btn--primary {
  color: var(--color-primary);
  font-weight: 500;
}

.action-btn--danger {
  color: var(--color-danger);
}

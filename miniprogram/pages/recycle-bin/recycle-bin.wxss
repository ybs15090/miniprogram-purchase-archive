.recycle-page {
  display: flex;
  flex-direction: column;
}

.row-list {
  padding: 0 24rpx;
}

.row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.row:last-child {
  border-bottom: none;
}

.row-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: var(--color-fill);
  flex-shrink: 0;
}

.row-cover--placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-3);
  font-size: 40rpx;
}

.row-main {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.row-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--color-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-meta {
  margin-top: 8rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  font-size: 24rpx;
  color: var(--color-text-3);
}

.row-ops {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 28rpx;
  flex-shrink: 0;
  margin-left: 24rpx;
  min-width: 188rpx;
}

.op {
  min-width: 188rpx;
  padding: 16rpx 0;
  text-align: center;
  border-radius: 14rpx;
  background: var(--color-bg);
  font-size: 26rpx;
  line-height: 1;
}

.op--restore {
  color: var(--color-primary);
}

.op--danger {
  color: var(--color-danger);
}

.poc-page {
  padding: 24rpx;
  box-sizing: border-box;
}

.poc-page__info {
  margin-bottom: 16rpx;
  padding: 16rpx;
  background: #eef3ff;
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #0052d9;
  word-break: break-all;
}

.poc-page__buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.poc-page__logs {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.log-entry {
  padding: 16rpx;
  border-radius: 8rpx;
  background: #f7f9fb;
  border-left: 6rpx solid #c4cbd4;
}

.log-entry--ok {
  border-left-color: #2ba471;
}

.log-entry--fail {
  border-left-color: #d54941;
}

.log-entry--info {
  border-left-color: #0052d9;
}

.log-time {
  font-size: 20rpx;
  color: #8896a4;
  margin-right: 12rpx;
}

.log-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.log-detail {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #4b5563;
  word-break: break-all;
  white-space: pre-wrap;
}

.category-page {
  display: flex;
  flex-direction: column;
}

.summary-grid {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}

.summary-grid > statistics-card {
  flex: 1;
  min-width: 0;
}

.section {
  margin-top: 28rpx;
}

.section-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text);
}

.match-toggle {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.match-toggle-label {
  font-size: 28rpx;
  color: var(--color-primary);
  font-weight: 500;
}

.match-toggle-hint {
  margin-top: 2rpx;
  font-size: 24rpx;
  color: var(--color-text-3);
}

.range-list {
  margin-top: 16rpx;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 14rpx;
}

.range-chip {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  color: var(--color-text-2);
  background: var(--color-card);
  transition: all 0.15s ease;
}

.range-chip--active {
  color: var(--color-text-inverse);
  background: var(--color-primary);
  font-weight: 500;
}

.tag-list {
  margin-top: 16rpx;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  background: var(--color-card);
  color: var(--color-text);
  font-size: 30rpx;
  transition: all 0.15s ease;
}

.tag--active {
  background: var(--color-primary-soft);
  color: var(--color-primary);
  border: 1rpx solid var(--color-primary-border);
}

.tag-count {
  font-size: 24rpx;
  color: var(--color-text-3);
}

.tag--active .tag-count {
  color: var(--color-primary);
}

.category-empty {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: var(--color-text-3);
}

.clear-filter {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: var(--color-warning);
}

.hit-list {
  margin-top: 16rpx;
}

.db-error {
  padding: 32rpx;
}

.db-error-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-danger);
}

.db-error-text {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: var(--color-text-2);
  line-height: 1.6;
}

.home-page {
  display: flex;
  flex-direction: column;
}

.search-row {
  margin: 0 -12rpx;
}

.toolbar {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 16rpx;
}

.sort-scroll {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
}

.sort-list {
  display: inline-flex;
  gap: 14rpx;
  padding: 4rpx 0;
}

.sort-chip {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  color: var(--color-text-2);
  background: var(--color-card);
  transition: all 0.15s ease;
}

.sort-chip--active {
  color: var(--color-text-inverse);
  background: var(--color-primary);
  font-weight: 500;
}

.layout-toggle {
  width: 64rpx;
  height: 64rpx;
  margin-left: 16rpx;
  border-radius: 16rpx;
  background: var(--color-card);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: var(--color-primary);
  flex-shrink: 0;
}

/* 双列网格 */
.list--grid {
  margin-top: 20rpx;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: space-between;
}

.list--grid > item-card {
  width: calc(50% - 10rpx);
  margin-bottom: 20rpx;
}

/* 单列 */
.list--rows {
  margin-top: 20rpx;
}

/* 数据库错误态 */
.db-error {
  margin-top: 24rpx;
  padding: 32rpx;
}

.db-error-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-danger);
}

.db-error-text {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: var(--color-text-2);
  line-height: 1.6;
}

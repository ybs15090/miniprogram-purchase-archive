.tab-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  /* 固定不透明背景，避免页面内容透过底栏造成视觉杂乱 */
  background: var(--color-card, #FFFFFF);
  border-top: 1rpx solid var(--color-border, #F0F2F4);
  box-shadow: 0 -4rpx 24rpx rgba(24, 24, 24, 0.06);
  padding: 8rpx 0 calc(8rpx + constant(safe-area-inset-bottom));
  padding: 8rpx 0 calc(8rpx + env(safe-area-inset-bottom));
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 6rpx 0 10rpx;
  position: relative;
  color: var(--color-text-2, #666666);
}

.tab-item--active {
  color: var(--color-primary, #0052D9);
}

.tab-icon {
  font-size: 36rpx;
  line-height: 1;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab-text {
  margin-top: 6rpx;
  font-size: 28rpx;
  line-height: 1.2;
}

.tab-indicator {
  position: absolute;
  top: 0;
  width: 36rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: var(--color-primary, #0052D9);
}

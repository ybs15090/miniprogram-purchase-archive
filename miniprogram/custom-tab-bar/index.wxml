<view class="tab-bar">
  <view
    wx:for="{{list}}"
    wx:key="path"
    class="tab-item {{selected === index ? 'tab-item--active' : ''}}"
    data-path="{{item.path}}"
    bindtap="switchTab"
  >
    <view class="tab-icon">{{item.icon}}</view>
    <view class="tab-text">{{item.text}}</view>
    <view wx:if="{{selected === index}}" class="tab-indicator" />
  </view>
</view>
